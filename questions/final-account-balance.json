{
  "question_id": "q_012_final_account_balance",
  "slug": "final-account-balance",
  "title": "Final Account Balance",
  "difficulty": "Easy",
  "company": "PayPal",
  "premium": false,
  "question": "Given a table containing information about bank deposits and withdrawals made using Paypal, write a query to retrieve the final account balance for each account, taking into account all the transactions recorded in the table with the assumption that there are no missing transactions.",
  "notes": [
    "Using account ID 101 as an example, \\$30.00 was deposited into this account, while \\$5.00 was withdrawn. Therefore, the final account balance can be calculated as the difference between the total deposits and withdrawals which is \\$30.00 - \\$5.00, resulting in a final balance of \\$25.00.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "account_id",
          "data_type": "INT"
        },
        {
          "column_name": "amount",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_type",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "transactions": [
      {
        "transaction_id": "123",
        "account_id": "101",
        "amount": "10.00",
        "transaction_type": "Deposit"
      },
      {
        "transaction_id": "124",
        "account_id": "101",
        "amount": "20.00",
        "transaction_type": "Deposit"
      },
      {
        "transaction_id": "125",
        "account_id": "101",
        "amount": "5.00",
        "transaction_type": "Withdrawal"
      },
      {
        "transaction_id": "126",
        "account_id": "201",
        "amount": "20.00",
        "transaction_type": "Deposit"
      },
      {
        "transaction_id": "128",
        "account_id": "201",
        "amount": "10.00",
        "transaction_type": "Withdrawal"
      }
    ]
  },
  "sample_output": [
    {
      "account_id": "101",
      "final_balance": "25.00"
    },
    {
      "account_id": "201",
      "final_balance": "10.00"
    }
  ],
  "reference_sql": "SELECT \n  account_id,\n  SUM(CASE WHEN transaction_type = 'Deposit' THEN amount ELSE -amount END) AS final_balance\nFROM transactions\nGROUP BY account_id\nORDER BY account_id;",
  "tags": [
    "aggregation",
    "easy",
    "finance",
    "paypal"
  ],
