        "time_spent": "4.50",
        "activity_date": "06/22/2022 12:00:00"
      },
      {
        "activity_id": "2425",
        "user_id": "123",
        "activity_type": "send",
        "time_spent": "3.50",
        "activity_date": "06/22/2022 12:00:00"
      },
      {
        "activity_id": "1413",
        "user_id": "456",
        "activity_type": "send",
        "time_spent": "5.67",
        "activity_date": "06/23/2022 12:00:00"
      },
      {
        "activity_id": "1414",
        "user_id": "789",
        "activity_type": "chat",
        "time_spent": "11.00",
        "activity_date": "06/25/2022 12:00:00"
      },
      {
        "activity_id": "2536",
        "user_id": "456",
        "activity_type": "open",
        "time_spent": "3.00",
        "activity_date": "06/25/2022 12:00:00"
      }
    ],
    "age_breakdown": [
      {
        "user_id": "123",
        "age_bucket": "31-35"
      },
      {
        "user_id": "456",
        "age_bucket": "26-30"
      },
      {
        "user_id": "789",
        "age_bucket": "21-25"
      }
    ]
  },
  "sample_output": [
    {
      "age_bucket": "26-30",
      "send_perc": "65.40",
      "open_perc": "34.60"
    },
    {
      "age_bucket": "31-35",
      "send_perc": "43.75",
      "open_perc": "56.25"
    }
  ],
  "reference_sql": "SELECT \n  ab.age_bucket,\n  ROUND(100.0 * SUM(CASE WHEN a.activity_type = 'send' THEN a.time_spent ELSE 0 END) / \n        SUM(CASE WHEN a.activity_type IN ('send', 'open') THEN a.time_spent ELSE 0 END), 2) AS send_perc,\n  ROUND(100.0 * SUM(CASE WHEN a.activity_type = 'open' THEN a.time_spent ELSE 0 END) / \n        SUM(CASE WHEN a.activity_type IN ('send', 'open') THEN a.time_spent ELSE 0 END), 2) AS open_perc\nFROM activities a\nJOIN age_breakdown ab ON a.user_id = ab.user_id\nWHERE a.activity_type IN ('send', 'open')\nGROUP BY ab.age_bucket;",
  "tags": [
    "aggregation",
