        "event_type": "comment",
        "event_date": "2022-06-18 14:00:00"
      },
      {
        "user_id": 648,
        "event_id": 202,
        "event_type": "sign-in",
        "event_date": "2022-07-10 09:30:00"
      },
      {
        "user_id": 742,
        "event_id": 301,
        "event_type": "sign-in",
        "event_date": "2022-07-02 11:00:00"
      },
      {
        "user_id": 999,
        "event_id": 401,
        "event_type": "like",
        "event_date": "2022-05-20 08:00:00"
      },
      {
        "user_id": 999,
        "event_id": 402,
        "event_type": "comment",
        "event_date": "2022-06-15 15:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "month": 7,
      "monthly_active_users": 2
    }
  ],
  "reference_sql": "WITH monthly_users AS (\n  SELECT DISTINCT \n    user_id, \n    MONTH(event_date) AS mth\n  FROM user_actions\n  WHERE event_type IN ('sign-in', 'like', 'comment')\n    AND YEAR(event_date) = 2022\n)\nSELECT \n  curr.mth AS month,\n  COUNT(DISTINCT curr.user_id) AS monthly_active_users\nFROM monthly_users curr\nJOIN monthly_users prev \n  ON curr.user_id = prev.user_id \n AND curr.mth = prev.mth + 1\nWHERE curr.mth = 7\nGROUP BY curr.mth;",
  "tags": [
    "date-manipulation",
    "facebook",
    "hard",
    "social-media"
  ],
