  "question_id": "q_063_user_session_activity",
  "slug": "user-session-activity",
  "title": "User Session Activity",
  "difficulty": "Medium",
  "company": "Twitter",
  "premium": true,
  "question": "Assume you are given tables for the session activity of users. Write a query to assign ranks to users by the total session duration\nfor the different session types they have had between a start date (2020-01-01) and an end date (2020-02-01).",
  "notes": [],
