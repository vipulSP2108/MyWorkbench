          "data_type": "INT"
        },
        {
          "column_name": "session_type",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "duration",
          "data_type": "INT"
        },
        {
          "column_name": "start_date",
          "data_type": "DATE"
        }
      ]
    }
  ],
