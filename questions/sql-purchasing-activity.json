{
  "question_id": "q_070_sql_purchasing_activity",
  "slug": "sql-purchasing-activity",
  "title": "Cumulative Purchases by Product Type",
  "difficulty": "Medium",
  "company": "Amazon",
  "premium": true,
  "question": "Assume you are given a table of spending activity by product type. Write a query to calculate the cumulative spend for each\nproduct type over time, in chronological order.",
  "notes": [],
  "tables": [
    {
      "table_name": "purchases",
      "columns": [
        {
          "column_name": "order_id",
          "data_type": "INT"
        },
        {
          "column_name": "product_type",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "order_date",
          "data_type": "DATE"
        }
      ]
    }
  ],
  "sample_data": {
    "purchases": [
      {
        "order_id": "1",
        "product_type": "Books",
        "spend": "20.00",
        "order_date": "01/01/2022"
      },
      {
        "order_id": "2",
        "product_type": "Toys",
        "spend": "15.50",
        "order_date": "01/01/2022"
      },
      {
        "order_id": "3",
        "product_type": "Books",
        "spend": "30.00",
        "order_date": "01/02/2022"
      },
      {
        "order_id": "4",
        "product_type": "Books",
        "spend": "12.25",
        "order_date": "01/03/2022"
      },
      {
        "order_id": "5",
        "product_type": "Toys",
        "spend": "8.00",
        "order_date": "01/03/2022"
      },
      {
        "order_id": "6",
        "product_type": "Toys",
        "spend": "20.00",
        "order_date": "01/05/2022"
      }
    ]
  },
  "sample_output": [
    {
      "product_type": "Books",
      "order_date": "01/01/2022",
      "cumulative_spend": "20.00"
    },
    {
      "product_type": "Books",
      "order_date": "01/02/2022",
      "cumulative_spend": "50.00"
    },
    {
      "product_type": "Books",
      "order_date": "01/03/2022",
      "cumulative_spend": "62.25"
    },
    {
      "product_type": "Toys",
      "order_date": "01/01/2022",
      "cumulative_spend": "15.50"
    },
    {
      "product_type": "Toys",
      "order_date": "01/03/2022",
      "cumulative_spend": "23.50"
    },
    {
      "product_type": "Toys",
      "order_date": "01/05/2022",
      "cumulative_spend": "43.50"
    }
  ],
  "reference_sql": "SELECT \n  order_date,\n  product_type,\n  ROUND(SUM(spend) OVER (PARTITION BY product_type ORDER BY order_date), 2) AS cum_spend\nFROM purchases\nORDER BY product_type, order_date;",
  "tags": [
    "aggregation",
    "amazon",
    "ecommerce",
    "medium",
    "window-function"
  ],
