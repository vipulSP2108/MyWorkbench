  "reference_sql": "SELECT \n  manufacturer,\n  CONCAT('$', ROUND(SUM(total_sales) / 1000000), ' million') AS sale\nFROM pharmacy_sales\nGROUP BY manufacturer\nORDER BY SUM(total_sales) DESC, manufacturer;",
