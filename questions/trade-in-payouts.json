        "payout_amount": 350
      },
      {
        "model_id": 113,
        "model_name": "iPhone 13",
        "payout_amount": 450
      },
      {
        "model_id": 114,
        "model_name": "iPhone 13 Pro Max",
        "payout_amount": 650
      }
    ]
  },
  "sample_output": [
    {
      "store_id": 512,
      "payout_total": 800
    }
  ],
  "reference_sql": "SELECT t.store_id,\n       SUM(p.payout_amount) AS payout_total\nFROM trade_in_transactions t\nJOIN trade_in_payouts p ON t.model_id = p.model_id\nGROUP BY t.store_id\nORDER BY payout_total DESC, t.store_id ASC;",
