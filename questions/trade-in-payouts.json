          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "payout_amount",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "trade_in_transactions": [
      {
        "transaction_id": 1,
        "model_id": 112,
        "store_id": 512,
        "transaction_date": "01/01/2022"
      },
      {
        "transaction_id": 2,
        "model_id": 113,
        "store_id": 512,
        "transaction_date": "01/01/2022"
      }
    ],
    "trade_in_payouts": [
      {
