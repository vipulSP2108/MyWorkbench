{
  "question_id": "q_065_email_table_transformation",
  "slug": "email-table-transformation",
  "title": "Email Table Transformation",
  "difficulty": "Medium",
  "company": "Facebook",
  "premium": true,
  "question": "Facebook logs user email interactions in a row-based format. Write a query to transform (pivot) this data so that each user has a single output row showing their total counts for emails sent, opened, and clicked. Order by user ID in ascending order.",
  "notes": [],
  "tables": [
    {
      "table_name": "email_logs",
      "columns": [
        {
          "column_name": "email_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "action_type",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "action_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "email_logs": [
      {
        "email_id": 1,
        "user_id": 101,
        "action_type": "sent",
        "action_date": "01/01/2022 08:00:00"
      },
      {
        "email_id": 2,
        "user_id": 101,
        "action_type": "opened",
        "action_date": "01/01/2022 08:05:00"
      },
      {
        "email_id": 3,
        "user_id": 101,
        "action_type": "clicked",
        "action_date": "01/01/2022 08:06:00"
      },
      {
        "email_id": 4,
        "user_id": 102,
        "action_type": "sent",
        "action_date": "01/02/2022 09:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "user_id": 101,
      "emails_sent": 1,
      "emails_opened": 1,
      "emails_clicked": 1
    },
    {
      "user_id": 102,
      "emails_sent": 1,
      "emails_opened": 0,
      "emails_clicked": 0
    }
  ],
  "reference_sql": "SELECT \n  user_id,\n  MAX(CASE WHEN action_type = 'open' THEN action_date END) AS open_date,\n  MAX(CASE WHEN action_type = 'click' THEN action_date END) AS click_date\nFROM email_logs\nGROUP BY user_id\nORDER BY user_id;",
