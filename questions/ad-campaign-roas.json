  "slug": "ad-campaign-roas",
  "title": "Ad Campaign ROAS",
  "difficulty": "Easy",
  "company": "Google",
  "premium": true,
  "question": "Google evaluates campaign efficiency using Return on Ad Spend (ROAS = Total Revenue / Total Spend).\n\nWrite a query to calculate total ROAS for each advertiser across all their ad campaigns. Output the advertiser ID and ROAS rounded to 2 decimal places, ordered by advertiser ID ascending.",
  "notes": [],
  "tables": [
    {
      "table_name": "ad_campaigns",
      "columns": [
        {
          "column_name": "campaign_id",
          "data_type": "INT"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "revenue",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "advertiser_id",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "ad_campaigns": [
      {
        "campaign_id": 1,
        "spend": "1000.00",
        "revenue": "900.00",
        "advertiser_id": 1
      },
      {
        "campaign_id": 2,
        "spend": "3000.00",
        "revenue": "12000.00",
        "advertiser_id": 2
      },
      {
        "campaign_id": 3,
        "spend": "5000.00",
        "revenue": "7500.00",
        "advertiser_id": 3
      }
    ]
  },
  "sample_output": [
    {
      "advertiser_id": 1,
      "roas": "0.90"
    },
    {
      "advertiser_id": 2,
      "roas": "4.00"
    },
    {
      "advertiser_id": 3,
      "roas": "1.50"
    }
  ],
  "reference_sql": "SELECT advertiser_id,\n       ROUND(SUM(revenue) / SUM(spend), 2) AS roas\nFROM ad_campaigns\nGROUP BY advertiser_id\nORDER BY advertiser_id;",
  "tags": [
