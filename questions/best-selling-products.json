        "category_name": "Home Appliances"
      },
      {
        "product_id": "3561",
        "product_name": "IKGAI",
        "category_name": "Books"
      }
    ],
    "product_sales": [
      {
        "product_id": "3690",
        "sales_quantity": "300",
        "rating": "4.9"
      },
      {
        "product_id": "5520",
        "sales_quantity": "70",
        "rating": "3.8"
      },
      {
        "product_id": "5952",
        "sales_quantity": "70",
        "rating": "4.0"
      },
      {
        "product_id": "3561",
        "sales_quantity": "290",
        "rating": "4.5"
      }
    ]
  },
  "sample_output": [
    {
      "category_name": "Books",
      "product_name": "Game of Thrones"
    },
    {
      "category_name": "Home Appliances",
      "product_name": "Dishwasher"
    }
  ],
  "reference_sql": "WITH ranked AS (\n  SELECT p.category_name, p.product_name, ps.sales_quantity,\n         ROW_NUMBER() OVER (PARTITION BY p.category_name ORDER BY ps.sales_quantity DESC) AS rn\n  FROM products p\n  JOIN product_sales ps ON p.product_id = ps.product_id\n)\nSELECT category_name, product_name, sales_quantity\nFROM ranked\nWHERE rn = 1\nORDER BY category_name;",
