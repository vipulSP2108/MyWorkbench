  "difficulty": "Easy",
  "company": "JPMorgan",
  "premium": false,
  "question": "Your team at JPMorgan Chase is preparing to launch a new credit card, and to gain some insights, you're analyzing how many credit cards were issued each month.\n\nWrite a query that outputs the name of each credit card and the difference in the number of issued cards between the month with the highest issuance cards and the lowest issuance. Arrange the results based on the largest disparity.",
  "notes": [
    "Chase Freedom Flex's best month was 70k cards issued and the worst month was 55k cards, so the difference is 15k cards.",
    "Chase Sapphire Reserve\u2019s best month was 180k cards issued and the worst month was 170k cards, so the difference is 10k cards.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "monthly_cards_issued",
      "columns": [
        {
          "column_name": "card_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "issued_amount",
          "data_type": "INT"
        },
        {
          "column_name": "issue_month",
          "data_type": "INT"
        },
        {
          "column_name": "issue_year",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "monthly_cards_issued": [
      {
        "card_name": "Chase Freedom Flex",
        "issued_amount": "55000",
        "issue_month": "1",
