      },
      {
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "170000",
        "issue_month": "1",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "175000",
        "issue_month": "2",
