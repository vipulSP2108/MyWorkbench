{
  "question_id": "q_093_event_friends_rec",
  "slug": "event-friends-rec",
  "title": "Event Friends Recommendation",
  "difficulty": "Hard",
  "company": "Facebook",
  "premium": true,
  "question": "Facebook wants to recommend new friends to people who show interest in attending 2 or more of the same private events.\n\nA user counts as interested if their attendance status is 'going' or 'maybe'. Recommendations run both ways: if x and y should be recommended to each other, the result has both (x, y) and (y, x). No duplicate pairs. Sort by user_a_id, then user_b_id.",
  "notes": [],
  "tables": [
    {
      "table_name": "friendship_status",
      "columns": [
        {
          "column_name": "user_a_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_b_id",
          "data_type": "INT"
        },
        {
          "column_name": "status",
          "data_type": "VARCHAR(50)"
        }
      ]
    },
    {
