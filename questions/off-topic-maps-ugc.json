  "title": "Google Maps Flagged UGC",
  "difficulty": "Medium",
  "company": "Google",
  "premium": true,
  "question": "As a Data Analyst on the Google Maps User Generated Content team, you and your Product Manager are investigating user-generated content (UGC): photos and reviews that independent users upload to Google Maps.\n\nWrite a query to determine which type of place (place_category) attracts the most UGC tagged as 'off-topic'. In the case of a tie, show the output in ascending order of place_category.",
  "notes": [],
  "tables": [
    {
      "table_name": "places",
      "columns": [
        {
          "column_name": "place_id",
          "data_type": "INT"
        },
        {
          "column_name": "place_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "place_category",
          "data_type": "VARCHAR(255)"
        }
      ]
    },
    {
      "table_name": "ugc",
      "columns": [
        {
          "column_name": "content_id",
          "data_type": "INT"
        },
        {
          "column_name": "place_id",
          "data_type": "INT"
        },
        {
          "column_name": "content_tag",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "places": [
      {
        "place_id": 1,
        "place_name": "Baar Baar",
        "place_category": "Restaurant"
      },
      {
        "place_id": 2,
        "place_name": "Rubirosa",
        "place_category": "Restaurant"
      },
      {
        "place_id": 3,
        "place_name": "Mr. Purple",
        "place_category": "Bar"
      },
      {
        "place_id": 4,
        "place_name": "La Caverna",
        "place_category": "Bar"
      }
    ],
    "ugc": [
      {
        "content_id": 101,
        "place_id": 1,
        "content_tag": "Off-topic"
      },
      {
        "content_id": 110,
        "place_id": 2,
        "content_tag": "Misinformation"
      },
      {
        "content_id": 153,
        "place_id": 2,
        "content_tag": "Off-topic"
      },
      {
        "content_id": 176,
        "place_id": 3,
        "content_tag": "Harassment"
      },
      {
        "content_id": 190,
        "place_id": 3,
        "content_tag": "Off-topic"
      }
    ]
  },
  "sample_output": [
    {
      "off_topic_places": "Restaurant"
    }
  ],
  "reference_sql": "SELECT p.place_name, COUNT(u.content_id) AS off_topic_count\nFROM places p\nJOIN ugc u ON p.place_id = u.place_id\nWHERE u.content_tag = 'Off-topic'\nGROUP BY p.place_name\nORDER BY off_topic_count DESC, p.place_name\nLIMIT 1;",
  "tags": [
    "aggregation",
    "cte",
