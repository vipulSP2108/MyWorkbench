        "place_category": "Bar"
      }
    ],
    "maps_ugc_review": [
      {
        "content_id": 101,
        "place_id": 1,
        "content_tag": "Off-topic"
      },
      {
        "content_id": 110,
        "place_id": 2,
        "content_tag": "Misinformation"
      },
      {
        "content_id": 153,
        "place_id": 2,
