  "title": "Data Science Skills",
  "difficulty": "Easy",
  "company": "LinkedIn",
  "premium": false,
  "question": "Given a table of candidates and their skills, you're tasked with finding the candidates best suited for an open Data Science job. You want to find candidates who are proficient in Python, Tableau, and PostgreSQL.\n\nWrite a query to list the candidates who possess all of the required skills for the job. Sort the output by candidate ID in ascending order.\n\nAssumption:",
  "notes": [
    "There are no duplicates in the candidates table.",
    "Candidate 123 is displayed because they have Python, Tableau, and PostgreSQL skills. 345 isn't included in the output because they're missing one of the required skills: PostgreSQL.",
    "The dataset you are querying against may have different input & output - this is just an example!",
    "p.s. give the hints below a try if you're stuck and don't know where to start!",
    "p.p.s if you find this problem too tricky, even after the hints, check out my 30-day SQL learning roadmap, which features my favorite free resources to learn SQL! After you strengthen your SQL foundations, I'm sure you'll be more than ready to tackle this question!"
  ],
  "tables": [
    {
      "table_name": "candidates",
      "columns": [
        {
          "column_name": "candidate_id",
          "data_type": "INT"
        },
        {
          "column_name": "skill",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "candidates": [
      {
        "candidate_id": "123",
        "skill": "Python"
      },
      {
        "candidate_id": "123",
        "skill": "Tableau"
      },
      {
        "candidate_id": "123",
        "skill": "PostgreSQL"
      },
      {
        "candidate_id": "234",
        "skill": "R"
      },
      {
        "candidate_id": "234",
        "skill": "PowerBI"
      },
      {
        "candidate_id": "234",
        "skill": "SQL Server"
      },
      {
        "candidate_id": "345",
        "skill": "Python"
      },
      {
        "candidate_id": "345",
        "skill": "Tableau"
      }
    ]
  },
  "sample_output": [
    {
      "candidate_id": 123
    }
  ],
  "reference_sql": "SELECT candidate_id\nFROM candidates\nWHERE skill IN ('Python', 'Tableau', 'PostgreSQL')\nGROUP BY candidate_id\nHAVING COUNT(DISTINCT skill) = 3\nORDER BY candidate_id;",
