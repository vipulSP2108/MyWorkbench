        "post_id": "442560",
        "post_content": "Just going to cry myself to sleep after watching Marley and Me.",
        "post_date": "07/08/2021 14:00:00"
      },
      {
        "user_id": "151652",
        "post_id": "111766",
        "post_content": "I'm so done with covid - need travelling ASAP!",
        "post_date": "07/12/2021 19:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "user_id": "151652",
      "days_between": "2"
    },
    {
      "user_id": "661093",
      "days_between": "21"
    }
  ],
  "reference_sql": "SELECT \n  user_id,\n  DATEDIFF(MAX(post_date), MIN(post_date)) AS days_between\nFROM posts\nWHERE YEAR(post_date) = 2021\nGROUP BY user_id\nHAVING COUNT(post_id) >= 2\nORDER BY user_id;",
