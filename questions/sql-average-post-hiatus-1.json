  "title": "Average Post Hiatus (Part 1)",
  "difficulty": "Easy",
  "company": "Facebook",
  "premium": false,
  "question": "Given a table of Facebook posts, for each user who posted at least twice in 2021, write a query to find the number of days between each user\u2019s first post of the year and last post of the year in the year 2021. Output the user and number of the days between each user's first and last post.",
  "notes": [
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "posts",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "post_id",
          "data_type": "INT"
        },
        {
          "column_name": "post_content",
          "data_type": "TEXT"
        },
        {
          "column_name": "post_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
