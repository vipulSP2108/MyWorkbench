  "reference_sql": "SELECT u.city, COUNT(t.order_id) AS total_orders\nFROM trades t\nJOIN users u ON t.user_id = u.user_id\nWHERE t.status = 'Completed'\nGROUP BY u.city\nORDER BY total_orders DESC, u.city ASC\nLIMIT 3;",
