{
  "question_id": "q_024_apple_pay_volume",
  "slug": "apple-pay-volume",
  "title": "ApplePay Volume",
  "difficulty": "Easy",
  "company": "Visa",
  "premium": true,
  "question": "Visa is analysing its partnership with ApplePay. Calculate the total transaction volume for each merchant where the transaction was performed via ApplePay.\n\nOutput the merchant ID and the total transactions. For merchants with no ApplePay transactions, output their total transaction volume as 0. Display the result in descending order of the transaction volume.\n\nTip from the source: check the spelling of the payment methods.",
  "notes": [],
  "tables": [
    {
      "table_name": "payments",
      "columns": [
        {
          "column_name": "merchant_id",
          "data_type": "INT"
        },
        {
          "column_name": "transaction_amount",
          "data_type": "INT"
        },
        {
          "column_name": "payment_method",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "payments": [
      {
        "merchant_id": 1,
        "transaction_amount": 600,
        "payment_method": "Contactless Chip"
      },
      {
        "merchant_id": 1,
        "transaction_amount": 850,
        "payment_method": "apple pay"
      },
      {
        "merchant_id": 1,
        "transaction_amount": 500,
        "payment_method": "Apple Pay"
      },
      {
        "merchant_id": 2,
        "transaction_amount": 560,
        "payment_method": "Magstripe"
      },
      {
        "merchant_id": 2,
        "transaction_amount": 400,
        "payment_method": "Samsung Pay"
      },
      {
        "merchant_id": 4,
        "transaction_amount": 1200,
        "payment_method": "apple pay"
      }
    ]
  },
  "sample_output": [
    {
      "merchant_id": 1,
      "total_transaction": 1350
    },
    {
      "merchant_id": 4,
      "total_transaction": 1200
    },
    {
      "merchant_id": 2,
      "total_transaction": 0
    }
  ],
  "reference_sql": "SELECT \n  merchant_id,\n  SUM(CASE WHEN LOWER(payment_method) = 'apple pay' THEN transaction_amount ELSE 0 END) AS total_transaction\nFROM payments\nGROUP BY merchant_id\nORDER BY total_transaction DESC, merchant_id ASC;",
