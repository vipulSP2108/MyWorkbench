          "column_name": "amount",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "products",
      "columns": [
        {
          "column_name": "product_id",
          "data_type": "INT"
        },
        {
          "column_name": "product_category",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "product_name",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
