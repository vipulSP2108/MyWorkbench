      },
      {
        "product_id": 3,
        "product_category": "Compute",
        "product_name": "Virtual Machines"
      }
    ]
  },
  "sample_output": [
    {
      "customer_id": 1
    }
  ],
  "reference_sql": "SELECT c.customer_id\nFROM customer_contracts c\nJOIN products p ON c.product_id = p.product_id\nGROUP BY c.customer_id\nHAVING COUNT(DISTINCT p.product_category) = (SELECT COUNT(DISTINCT product_category) FROM products)\nORDER BY c.customer_id;",
