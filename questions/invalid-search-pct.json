{
  "question_id": "q_071_invalid_search_pct",
  "slug": "invalid-search-pct",
  "title": "Invalid Search Results",
  "difficulty": "Medium",
  "company": "Google",
  "premium": true,
  "question": "Google Search Quality tracks invalid search queries. A search is classified as invalid if is_invalid is true or if num_results is 0.\n\nWrite a query to calculate the overall percentage of invalid searches, rounded to 2 decimal places.",
  "notes": [],
  "tables": [
    {
      "table_name": "search_category",
      "columns": [
        {
          "column_name": "search_id",
          "data_type": "INT"
        },
        {
          "column_name": "query",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "num_results",
          "data_type": "INT"
        },
        {
          "column_name": "is_invalid",
          "data_type": "BOOLEAN"
        }
      ]
    }
  ],
  "sample_data": {
    "search_category": [
      {
        "search_id": 1,
        "query": "sql tutorial",
        "num_results": 1500,
        "is_invalid": "false"
      },
      {
        "search_id": 2,
        "query": "asdfghjkl",
        "num_results": 0,
        "is_invalid": "false"
      },
      {
        "search_id": 3,
        "query": "broken syntax",
        "num_results": 0,
        "is_invalid": "true"
      },
      {
        "search_id": 4,
        "query": "python docs",
        "num_results": 300,
        "is_invalid": "false"
      }
    ]
  },
  "sample_output": [
    {
      "invalid_search_pct": "50.00"
    }
  ],
  "reference_sql": "SELECT \n  ROUND(100.0 * SUM(CASE WHEN is_invalid = 1 OR num_results = 0 THEN 1 ELSE 0 END) / COUNT(*), 2) AS invalid_pct\nFROM search_category;",
