        "assembly_step": "1"
      },
      {
        "part": "bumper",
        "finish_date": "02/22/2022 00:00:00",
        "assembly_step": "2"
      },
      {
        "part": "bumper",
        "finish_date": "",
        "assembly_step": "3"
      },
      {
        "part": "bumper",
        "finish_date": "",
        "assembly_step": "4"
      }
    ]
  },
  "sample_output": [
    {
      "part": "bumper",
      "assembly_step": "3"
    },
    {
      "part": "bumper",
      "assembly_step": "4"
    }
  ],
  "reference_sql": "SELECT part, assembly_step\nFROM parts_assembly\nWHERE finish_date IS NULL\nORDER BY part, assembly_step;",
