        "call_category": "n/a",
        "call_date": "2023-01-26T01:21:27Z",
        "call_duration_secs": "992"
      },
      {
        "policy_holder_id": "2",
        "case_id": "8471a3d4-6fc7-4bb2-9fc7-4583e3638a9e",
        "call_category": "emergency assistance",
        "call_date": "2023-03-09T10:58:54Z",
        "call_duration_secs": "128"
      },
      {
        "policy_holder_id": "2",
        "case_id": "38208fae-bad0-49bf-99aa-7842ba2e37bc",
        "call_category": "benefits",
        "call_date": "2023-06-05T07:35:43Z",
        "call_duration_secs": "619"
      }
    ]
  },
  "sample_output": [
    {
      "uncategorised_call_pct": "20.0"
    }
  ],
  "reference_sql": "SELECT \n  ROUND(100.0 * SUM(CASE WHEN call_category IS NULL OR call_category = 'n/a' THEN 1 ELSE 0 END) / COUNT(*), 1) AS uncategorised_call_pct\nFROM callers;",
