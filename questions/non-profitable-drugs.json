  "reference_sql": "SELECT \n  manufacturer,\n  COUNT(drug) AS drug_count,\n  SUM(cogs - total_sales) AS total_loss\nFROM pharmacy_sales\nWHERE total_sales < cogs\nGROUP BY manufacturer\nORDER BY total_loss DESC, manufacturer ASC;",
