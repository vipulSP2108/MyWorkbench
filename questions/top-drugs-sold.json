      "manufacturer": "Novartis",
      "top_drug": "Entresto",
      "total_sales": "200000.00"
    },
    {
      "manufacturer": "Pfizer",
      "top_drug": "Lipitor",
      "total_sales": "150000.00"
    }
  ],
  "reference_sql": "WITH ranked AS (\n  SELECT manufacturer, drug,\n         ROW_NUMBER() OVER (PARTITION BY manufacturer ORDER BY units_sold DESC) AS rn\n  FROM pharmacy_sales\n)\nSELECT manufacturer, drug\nFROM ranked\nWHERE rn <= 2\nORDER BY manufacturer, rn;",
