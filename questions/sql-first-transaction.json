{
  "question_id": "q_064_sql_first_transaction",
  "slug": "sql-first-transaction",
  "title": "First Transaction",
  "difficulty": "Medium",
  "company": "Etsy",
  "premium": true,
  "question": "You are given a table containing Etsy user transactions. Write a query that retrieves the customers whose first transaction was valued at $50 or more. Output the total number of users who meet this criteria.",
  "notes": [],
  "tables": [
    {
      "table_name": "user_transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "user_transactions": [
      {
        "transaction_id": 759274,
        "user_id": 111,
        "spend": "49.50",
        "transaction_date": "02/03/2022 00:00:00"
      },
      {
        "transaction_id": 850371,
        "user_id": 111,
        "spend": "51.00",
        "transaction_date": "03/15/2022 00:00:00"
      },
      {
        "transaction_id": 615348,
