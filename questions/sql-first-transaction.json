        "user_id": 156,
        "spend": "151.00",
        "transaction_date": "04/04/2022 00:00:00"
      },
      {
        "transaction_id": 248475,
        "user_id": 156,
        "spend": "87.00",
        "transaction_date": "04/16/2022 00:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "users": 1
    }
  ],
  "reference_sql": "WITH first_orders AS (\n  SELECT user_id, spend,\n         ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY transaction_date) AS rn\n  FROM user_transactions\n)\nSELECT COUNT(user_id) AS users\nFROM first_orders\nWHERE rn = 1 AND spend >= 50;",
