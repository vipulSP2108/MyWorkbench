{
  "question_id": "q_055_histogram_users_purchases",
  "slug": "histogram-users-purchases",
  "title": "Histogram of Users and Purchases",
  "difficulty": "Medium",
  "company": "Walmart",
  "premium": false,
  "question": "Assume you're given a table on Walmart user transactions. Based on their most recent transaction date, write a query that retrieve the users along with the number of products they bought.\n\nOutput the user's most recent transaction date, user ID, and the number of products, sorted in chronological order by the transaction date. If the transaction date is the same, order by the user_id.",
  "notes": [
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "user_transactions",
      "columns": [
        {
          "column_name": "product_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "user_transactions": [
      {
        "product_id": "3673",
        "user_id": "123",
        "spend": "68.90",
        "transaction_date": "07/08/2022 12:00:00"
      },
      {
