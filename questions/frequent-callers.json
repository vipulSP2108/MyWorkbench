{
  "question_id": "q_022_frequent_callers",
  "slug": "frequent-callers",
  "title": "Patient Support Analysis (Part 1)",
  "difficulty": "Easy",
  "company": "UnitedHealth",
  "premium": false,
  "question": "UnitedHealth Group (UHG) has a program called Advocate4Me, which allows policy holders (or, members) to call an advocate and receive support for their health care needs \u2013 whether that's claims and benefits support, drug coverage, pre- and post-authorisation, medical records, emergency assistance, or member portal services.\n\nWrite a query to find how many UHG policy holders made three, or more calls, assuming each call is identified by the case_id column.\n\nIf you like this question, try out Patient Support Analysis (Part 2)!",
  "notes": [
    "The only caller who made three, or more calls is policy holder ID 2.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "callers",
      "columns": [
        {
          "column_name": "policy_holder_id",
          "data_type": "INT"
        },
        {
          "column_name": "case_id",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "call_category",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "call_date",
          "data_type": "DATETIME"
        },
        {
          "column_name": "call_duration_secs",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "callers": [
      {
        "policy_holder_id": "1",
        "case_id": "f1d012f9-9d02-4966-a968-bf6c5bc9a9fe",
        "call_category": "emergency assistance",
        "call_date": "2023-04-13T19:16:53Z",
        "call_duration_secs": "144"
      },
      {
        "policy_holder_id": "1",
        "case_id": "41ce8fb6-1ddd-4f50-ac31-07bfcce6aaab",
        "call_category": "authorisation",
        "call_date": "2023-05-25T09:09:30Z",
        "call_duration_secs": "815"
      },
      {
        "policy_holder_id": "2",
        "case_id": "9b1af84b-eedb-4c21-9730-6f099cc2cc5e",
        "call_category": "claims assistance",
        "call_date": "2023-01-26T01:21:27Z",
        "call_duration_secs": "992"
      },
      {
        "policy_holder_id": "2",
        "case_id": "8471a3d4-6fc7-4bb2-9fc7-4583e3638a9e",
        "call_category": "emergency assistance",
        "call_date": "2023-03-09T10:58:54Z",
        "call_duration_secs": "128"
      },
      {
        "policy_holder_id": "2",
        "case_id": "38208fae-bad0-49bf-99aa-7842ba2e37bc",
        "call_category": "benefits",
        "call_date": "2023-06-05T07:35:43Z",
        "call_duration_secs": "619"
      }
    ]
  },
  "sample_output": [
    {
      "policy_holder_count": "1"
    }
  ],
  "reference_sql": "WITH policy_calls AS (\n  SELECT policy_holder_id, COUNT(case_id) AS call_count\n  FROM callers\n  GROUP BY policy_holder_id\n  HAVING COUNT(case_id) >= 3\n)\nSELECT COUNT(policy_holder_id) AS policy_holder_count\nFROM policy_calls;",
