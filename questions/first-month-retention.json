{
  "question_id": "q_095_first_month_retention",
  "slug": "first-month-retention",
  "title": "Weekly Churn Rates",
  "difficulty": "Hard",
  "company": "Facebook",
  "premium": true,
  "question": "Facebook wants to analyze user retention. A user is considered churned in their first month if they have no activity within 28 days following their signup date.\n\nWrite a query to calculate the first-month churn rate for users grouped by their signup week. Output the signup week start date and the churn rate percentage rounded to 2 decimal places.",
  "notes": [],
  "tables": [
    {
      "table_name": "users",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "signup_date",
          "data_type": "DATETIME"
        }
      ]
    },
    {
      "table_name": "user_actions",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "event_date",
          "data_type": "DATETIME"
        },
        {
          "column_name": "action_type",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "users": [
      {
        "user_id": 1,
        "signup_date": "06/01/2022 00:00:00"
      },
      {
        "user_id": 2,
        "signup_date": "06/02/2022 00:00:00"
      },
      {
        "user_id": 3,
        "signup_date": "06/08/2022 00:00:00"
      }
    ],
    "user_actions": [
      {
        "user_id": 1,
        "event_date": "06/10/2022 00:00:00",
        "action_type": "login"
      },
      {
        "user_id": 2,
        "event_date": "07/15/2022 00:00:00",
        "action_type": "post"
      },
      {
        "user_id": 3,
        "event_date": "06/12/2022 00:00:00",
        "action_type": "login"
      }
    ]
  },
  "sample_output": [
    {
      "signup_week": "05/30/2022",
      "churn_rate": "50.00"
    },
    {
      "signup_week": "06/06/2022",
      "churn_rate": "0.00"
    }
  ],
  "reference_sql": "SELECT \n  ROUND(100.0 * COUNT(DISTINCT a.user_id) / COUNT(DISTINCT u.user_id), 2) AS retention_rate\nFROM users u\nLEFT JOIN user_actions a \n  ON u.user_id = a.user_id \n AND DATEDIFF(a.event_date, u.signup_date) BETWEEN 1 AND 30;",
  "tags": [
    "date-manipulation",
    "facebook",
    "hard",
    "math",
    "social-media"
  ],
