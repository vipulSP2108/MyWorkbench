  "reference_sql": "SELECT c.email\nFROM crm_contacts c\nJOIN marketing_touches m ON c.contact_id = m.contact_id\nWHERE m.event_type = 'webinar'\nGROUP BY c.email\nHAVING COUNT(m.event_id) >= 2\nORDER BY c.email;",
