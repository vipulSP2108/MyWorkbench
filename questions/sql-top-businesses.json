      }
    ]
  },
  "sample_output": [
    {
      "top_rated_businesses": "3",
      "top_rated_pct": "60.00"
    }
  ],
  "reference_sql": "WITH biz AS (\n  SELECT business_id, MIN(review_stars) AS worst_review\n  FROM reviews\n  GROUP BY business_id\n)\nSELECT \n  SUM(CASE WHEN worst_review >= 4 THEN 1 ELSE 0 END) AS top_rated_businesses,\n  ROUND(100.0 * SUM(CASE WHEN worst_review >= 4 THEN 1 ELSE 0 END) / COUNT(*), 0) AS top_rated_pct\nFROM biz;",
