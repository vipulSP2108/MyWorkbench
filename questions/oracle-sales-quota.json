{
  "question_id": "q_034_oracle_sales_quota",
  "slug": "oracle-sales-quota",
  "title": "Who Made Quota?",
  "difficulty": "Easy",
  "company": "Oracle",
  "premium": true,
  "question": "As a data analyst on the Oracle Sales Operations team, you are given a list of salespeople's deals and the annual quota each needs to hit.\n\nWrite a query that outputs each employee id and whether they hit the quota or not ('yes' or 'no'). Order the results by employee id in ascending order.\n\nDefinitions: deals are the deals acquired by a salesperson in the year (each salesperson may have more than one). The quota is the total annual quota for each salesperson.",
  "notes": [],
  "tables": [
    {
      "table_name": "deals",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "deal_size",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "sales_quotas",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "quota",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "deals": [
      {
        "employee_id": 101,
        "deal_size": 400000
      },
      {
        "employee_id": 101,
        "deal_size": 300000
      },
      {
        "employee_id": 201,
        "deal_size": 500000
      },
      {
        "employee_id": 301,
        "deal_size": 500000
      }
    ],
    "sales_quotas": [
      {
        "employee_id": 101,
        "quota": 500000
      },
      {
        "employee_id": 201,
        "quota": 400000
      },
      {
        "employee_id": 301,
        "quota": 600000
      }
    ]
  },
  "sample_output": [
    {
      "employee_id": 101,
      "made_quota": "yes"
    },
    {
      "employee_id": 201,
      "made_quota": "yes"
    },
    {
      "employee_id": 301,
      "made_quota": "no"
    }
  ],
  "reference_sql": "SELECT q.employee_id,\n       CASE WHEN IFNULL(SUM(d.deal_size), 0) >= q.quota THEN 1 ELSE 0 END AS made_quota\nFROM sales_quotas q\nLEFT JOIN deals d ON q.employee_id = d.employee_id\nGROUP BY q.employee_id, q.quota\nORDER BY q.employee_id;",
