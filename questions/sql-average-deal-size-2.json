  "title": "Average Deal Size (Part 2)",
  "difficulty": "Medium",
  "company": "Salesforce",
  "premium": true,
  "question": "Salesforce evaluates deal sizing by client tier (seat count). Write a query to compute the average deal size for closed-won deals grouped by seat count. Round the output to 2 decimal places and order by seat count in ascending order.",
  "notes": [],
  "tables": [
    {
      "table_name": "deals",
      "columns": [
        {
          "column_name": "deal_id",
          "data_type": "INT"
        },
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "num_seats",
          "data_type": "INT"
        },
        {
          "column_name": "deal_size",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "status",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "deals": [
      {
        "deal_id": 1,
        "employee_id": 10,
        "num_seats": 50,
        "deal_size": "25000.00",
        "status": "Won"
      },
      {
        "deal_id": 2,
        "employee_id": 11,
        "num_seats": 50,
        "deal_size": "35000.00",
        "status": "Won"
      },
      {
        "deal_id": 3,
        "employee_id": 12,
        "num_seats": 100,
        "deal_size": "80000.00",
        "status": "Lost"
      }
    ]
  },
  "sample_output": [
    {
      "num_seats": 50,
      "avg_deal_size": "30000.00"
    }
  ],
  "reference_sql": "SELECT \n  CASE \n    WHEN num_seats < 20 THEN 'Small'\n    WHEN num_seats BETWEEN 20 AND 99 THEN 'Medium'\n    ELSE 'Large'\n  END AS tier,\n  ROUND(AVG(deal_size), 2) AS avg_deal_size\nFROM deals\nWHERE status = 'Won'\nGROUP BY \n  CASE \n    WHEN num_seats < 20 THEN 'Small'\n    WHEN num_seats BETWEEN 20 AND 99 THEN 'Medium'\n    ELSE 'Large'\n  END\nORDER BY avg_deal_size DESC, tier ASC;",
