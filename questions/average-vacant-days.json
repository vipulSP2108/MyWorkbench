{
  "question_id": "q_098_average_vacant_days",
  "slug": "average-vacant-days",
  "title": "Average Vacant Days",
  "difficulty": "Hard",
  "company": "Airbnb",
  "premium": true,
  "question": "The strategy team at Airbnb is analyzing the impact of Covid-19 during 2021. Write a query that outputs the average vacant days across the Airbnbs in 2021. Some properties have gone out of business, so only analyze rentals that are currently active. Round the result to a whole number.\n\nAssumptions: (1) the is_active field equals 1 when the property is active and 0 otherwise. (2) When the check-in or check-out date falls in a year other than 2021, limit the calculation to the beginning or end of 2021 respectively. (3) A listing can be active even if it has no bookings throughout the year.",
  "notes": [],
  "tables": [
    {
      "table_name": "bookings",
      "columns": [
        {
          "column_name": "listing_id",
          "data_type": "INT"
        },
        {
          "column_name": "checkin_date",
          "data_type": "DATE"
        },
        {
          "column_name": "checkout_date",
          "data_type": "DATE"
        }
      ]
    },
    {
      "table_name": "listings",
      "columns": [
        {
          "column_name": "listing_id",
          "data_type": "INT"
        },
        {
          "column_name": "is_active",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "bookings": [
      {
        "listing_id": 1,
        "checkin_date": "08/17/2021 00:00:00",
        "checkout_date": "08/19/2021 00:00:00"
      },
      {
        "listing_id": 1,
        "checkin_date": "08/19/2021 00:00:00",
        "checkout_date": "08/25/2021 00:00:00"
      },
      {
        "listing_id": 2,
        "checkin_date": "08/19/2021 00:00:00",
        "checkout_date": "09/22/2021 00:00:00"
      },
      {
        "listing_id": 3,
        "checkin_date": "12/23/2021 00:00:00",
        "checkout_date": "01/05/2022 00:00:00"
      }
    ],
    "listings": [
      {
        "listing_id": 1,
        "is_active": 1
      },
      {
        "listing_id": 2,
        "is_active": 0
      },
      {
        "listing_id": 3,
        "is_active": 1
      }
    ]
  },
  "sample_output": [
    {
      "avg_vacant_days": 357
    }
  ],
  "reference_sql": "SELECT \n  ROUND(AVG(365 - IFNULL(DATEDIFF(b.checkout_date, b.checkin_date), 0)), 1) AS avg_vacant_days\nFROM listings l\nLEFT JOIN bookings b ON l.listing_id = b.listing_id\nWHERE l.is_active = 1;",
