{
  "question_id": "q_035_sql_third_transaction",
  "slug": "sql-third-transaction",
  "title": "User's Third Transaction",
  "difficulty": "Medium",
  "company": "Uber",
  "premium": false,
  "question": "Assume you are given the table below on Uber transactions made by users. Write a query to obtain the third transaction of every user. Output the user id, spend and transaction date.",
  "notes": [
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "transactions",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "transactions": [
      {
        "user_id": "111",
        "spend": "100.50",
        "transaction_date": "01/08/2022 12:00:00"
      },
      {
        "user_id": "111",
        "spend": "55.00",
        "transaction_date": "01/10/2022 12:00:00"
      },
      {
        "user_id": "121",
        "spend": "36.00",
        "transaction_date": "01/18/2022 12:00:00"
      },
      {
        "user_id": "145",
        "spend": "24.99",
        "transaction_date": "01/26/2022 12:00:00"
      },
      {
        "user_id": "111",
        "spend": "89.60",
        "transaction_date": "02/05/2022 12:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "user_id": "111",
      "spend": "89.60",
      "transaction_date": "02/05/2022 12:00:00"
    }
  ],
  "reference_sql": "WITH ranked AS (\n  SELECT user_id, spend, transaction_date,\n         ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY transaction_date) AS rn\n  FROM transactions\n)\nSELECT user_id, spend, transaction_date\nFROM ranked\nWHERE rn = 3;",
