  "title": "Monthly Merchant Balance",
  "difficulty": "Hard",
  "company": "Visa",
  "premium": true,
  "question": "You have access to all the transactions for a given merchant account. Write a query to print the cumulative balance of the merchant account at the end of each day, with the total balance reset back to zero at the end of the month.\n\nOutput the transaction date and the cumulative balance.",
  "notes": [],
  "tables": [
    {
      "table_name": "transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "type",
          "data_type": "VARCHAR(50)"
        },
        {
          "column_name": "amount",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "transactions": [
      {
        "transaction_id": 19153,
        "type": "deposit",
        "amount": "65.90",
        "transaction_date": "07/10/2022 10:00:00"
      },
      {
        "transaction_id": 53151,
        "type": "deposit",
