      },
      {
        "transaction_id": 77134,
        "type": "deposit",
        "amount": "32.60",
        "transaction_date": "07/10/2022 10:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "transaction_date": "07/08/2022 12:00:00",
      "balance": "106.66"
    },
    {
      "transaction_date": "07/10/2022 12:00:00",
      "balance": "205.16"
    }
  ],
  "reference_sql": "SELECT \n  DATE_FORMAT(transaction_date, '%Y-%m') AS transaction_month,\n  SUM(CASE WHEN type = 'credit' THEN amount ELSE -amount END) AS balance\nFROM transactions\nGROUP BY DATE_FORMAT(transaction_date, '%Y-%m')\nORDER BY transaction_month;",
