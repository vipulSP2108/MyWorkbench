    },
    {
      "product_id": 4,
      "category": "Jeans",
      "name": "Levi 511"
    },
    {
      "product_id": 5,
      "category": "Jeans",
      "name": "Wrangler Straight Fit"
    },
    {
      "product_id": 6,
      "category": "Shirts",
      "name": "Lacoste Classic Polo"
    },
    {
      "product_id": 7,
      "category": "Shirts",
      "name": "Nautica Linen Shirt"
    }
  ],
  "reference_sql": "WITH grouped AS (\n  SELECT \n    product_id,\n    category,\n    name,\n    COUNT(NULLIF(category, '')) OVER (ORDER BY product_id) AS grp\n  FROM products\n)\nSELECT \n  product_id,\n  MAX(NULLIF(category, '')) OVER (PARTITION BY grp) AS category,\n  name\nFROM grouped\nORDER BY product_id;",
