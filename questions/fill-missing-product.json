  "title": "Fill Missing Client Data",
  "difficulty": "Medium",
  "company": "Accenture",
  "premium": true,
  "question": "When accessing Accenture's retailer client's database, you notice that the category column in the products table contains null values.\n\nWrite a query that returns the updated product table with all the category values filled in, assuming the first product in each category always has a defined category value.",
  "notes": [],
  "tables": [
    {
      "table_name": "products",
      "columns": [
        {
          "column_name": "product_id",
          "data_type": "INT"
        },
        {
          "column_name": "category",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "name",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "products": [
      {
        "product_id": 1,
        "category": "Shoes",
        "name": "Sperry Boat Shoe"
      },
      {
        "product_id": 2,
        "category": "",
