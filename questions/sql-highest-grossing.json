{
  "question_id": "q_039_sql_highest_grossing",
  "slug": "sql-highest-grossing",
  "title": "Highest-Grossing Items",
  "difficulty": "Medium",
  "company": "Amazon",
  "premium": false,
  "question": "Assume you're given a table containing data on Amazon customers and their spending on products in different category, write a query to identify the top two highest-grossing products within each category in the year 2022. The output should include the category, product, and total spend.",
  "notes": [
    "Within the \"appliance\" category, the top two highest-grossing products are \"refrigerator\" and \"washing machine.\"",
    "In the \"electronics\" category, the top two highest-grossing products are \"vacuum\" and \"wireless headset.\"",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "product_spend",
      "columns": [
        {
          "column_name": "category",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "product",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "product_spend": [
      {
        "category": "appliance",
        "product": "refrigerator",
        "user_id": "165",
        "spend": "246.00",
        "transaction_date": "12/26/2021 12:00:00"
      },
      {
