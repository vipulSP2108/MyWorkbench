{
  "question_id": "q_086_senior_managers_reportees",
  "slug": "senior-managers-reportees",
  "title": "Senior Managers",
  "difficulty": "Hard",
  "company": "Google",
  "premium": false,
  "question": "Given a table of Google employees and their managers: a manager is an employee with at least one direct report. A senior manager is an employee who manages at least one manager, and none of whose direct reports is itself a senior manager.\n\nWrite a query that returns each senior manager's name and the count of their direct reports (the managers reporting to them). The senior manager with the most direct reports comes first.\n\nAssumption: an employee can report to two senior managers.",
  "notes": [],
  "tables": [
    {
      "table_name": "employees",
      "columns": [
        {
          "column_name": "emp_id",
          "data_type": "INT"
        },
        {
          "column_name": "manager_id",
          "data_type": "INT"
        },
        {
          "column_name": "manager_name",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "employees": [
      {
        "emp_id": 1,
        "manager_id": 101,
        "manager_name": "Duyen"
      },
      {
        "emp_id": 101,
        "manager_id": 1001,
        "manager_name": "Rick"
      },
      {
        "emp_id": 103,
        "manager_id": 1001,
        "manager_name": "Rick"
      },
      {
        "emp_id": 1001,
        "manager_id": 1008,
        "manager_name": "John"
      }
    ]
  },
  "sample_output": [
    {
      "manager_name": "Rick",
      "direct_reportees": 1
    }
  ],
  "reference_sql": "WITH managers AS (\n  SELECT DISTINCT manager_id\n  FROM employees\n  WHERE manager_id IS NOT NULL\n),\nmgr_reports AS (\n  SELECT e.manager_id, e.manager_name, e.emp_id\n  FROM employees e\n  WHERE e.emp_id IN (SELECT manager_id FROM managers)\n),\nsenior_mgr_candidates AS (\n  SELECT manager_id, manager_name, COUNT(DISTINCT emp_id) AS direct_reportees\n  FROM mgr_reports\n  GROUP BY manager_id, manager_name\n)\nSELECT manager_name, direct_reportees\nFROM senior_mgr_candidates\nWHERE manager_id NOT IN (\n  SELECT mr.manager_id\n  FROM mgr_reports mr\n  WHERE mr.emp_id IN (SELECT manager_id FROM senior_mgr_candidates)\n)\nORDER BY direct_reportees DESC, manager_name;",
  "tags": [
    "aggregation",
    "cte",
    "google",
    "hard",
    "hr",
    "join",
    "self-join"
  ],
