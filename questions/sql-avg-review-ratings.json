      "avg_stars": "2.50"
    }
  ],
  "reference_sql": "SELECT \n  MONTH(submit_date) AS mth,\n  product_id,\n  ROUND(AVG(stars), 2) AS avg_stars\nFROM reviews\nGROUP BY MONTH(submit_date), product_id\nORDER BY mth, product_id;",
