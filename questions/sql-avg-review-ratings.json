          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "submit_date",
          "data_type": "DATETIME"
        },
        {
          "column_name": "product_id",
          "data_type": "INT"
        },
        {
          "column_name": "stars",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "reviews": [
      {
