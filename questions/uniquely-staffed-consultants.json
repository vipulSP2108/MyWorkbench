  "title": "Uniquely Staffed Consultants",
  "difficulty": "Hard",
  "company": "Accenture",
  "premium": true,
  "question": "As a Data Analyst on Accenture's People Operations team, work out how many consultants are staffed to each client, and how many consultants are exclusively staffed to a single client.\n\nOutput the client name with the number of staffed consultants and the number exclusively staffed, ordered by client name.",
  "notes": [],
  "tables": [
    {
      "table_name": "staffing",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "engagement_id",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "engagements",
      "columns": [
        {
          "column_name": "engagement_id",
          "data_type": "INT"
        },
        {
          "column_name": "project_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "client_name",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
