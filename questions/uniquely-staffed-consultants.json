      {
        "engagement_id": 1,
        "project_name": "SAP Logistics Modernization",
        "client_name": "Department of Defense"
      },
      {
        "engagement_id": 2,
        "project_name": "Oracle Cloud Migration",
        "client_name": "Department of Education"
      },
      {
        "engagement_id": 3,
        "project_name": "Trust & Safety Operations",
        "client_name": "Google"
      },
      {
        "engagement_id": 4,
        "project_name": "SAP IoT Cloud Integration",
        "client_name": "Google"
      }
    ]
  },
  "sample_output": [
    {
      "client_name": "Department of Defense",
      "total_staffed": 2,
      "exclusive_staffed": 1
    },
    {
      "client_name": "Department of Education",
      "total_staffed": 1,
      "exclusive_staffed": 0
    },
    {
      "client_name": "Google",
      "total_staffed": 2,
      "exclusive_staffed": 2
    }
  ],
  "reference_sql": "SELECT s.employee_id\nFROM staffing s\nJOIN engagements e ON s.engagement_id = e.engagement_id\nGROUP BY s.employee_id\nHAVING COUNT(DISTINCT e.client_name) = 1\nORDER BY s.employee_id;",
