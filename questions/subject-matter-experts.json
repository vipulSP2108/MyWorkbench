{
  "question_id": "q_025_subject_matter_experts",
  "slug": "subject-matter-experts",
  "title": "Subject Matter Experts",
  "difficulty": "Easy",
  "company": "Accenture",
  "premium": true,
  "question": "Identify Subject Matter Experts (SMEs) at Accenture from their work experience in specific domains. An employee is an SME if they meet either criterion: (1) 8 or more years of work experience in a single domain, or (2) 12 or more years of work experience across two different domains.\n\nReturn the employee IDs of all the subject matter experts.",
  "notes": [],
  "tables": [
    {
      "table_name": "employee_expertise",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "domain",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "years_of_experience",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "employee_expertise": [
      {
        "employee_id": 101,
        "domain": "Digital Transformation",
        "years_of_experience": 9
      },
      {
        "employee_id": 102,
        "domain": "Supply Chain",
        "years_of_experience": 6
      },
      {
        "employee_id": 102,
        "domain": "IoT",
        "years_of_experience": 7
      },
      {
        "employee_id": 103,
        "domain": "Change Management",
        "years_of_experience": 4
      },
      {
        "employee_id": 104,
        "domain": "DevOps",
        "years_of_experience": 5
      },
      {
        "employee_id": 104,
        "domain": "Cloud Migration",
        "years_of_experience": 5
      },
      {
        "employee_id": 104,
        "domain": "Agile Transformation",
        "years_of_experience": 5
      }
    ]
  },
  "sample_output": [
    {
      "employee_id": 101
    },
    {
      "employee_id": 102
    }
  ],
  "reference_sql": "SELECT employee_id\nFROM employee_expertise\nGROUP BY employee_id\nHAVING MAX(years_of_experience) >= 8 \n    OR (COUNT(DISTINCT domain) = 2 AND SUM(years_of_experience) >= 12)\nORDER BY employee_id;",
  "tags": [
