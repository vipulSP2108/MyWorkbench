{
  "question_id": "q_067_consulting_bench_time",
  "slug": "consulting-bench-time",
  "title": "Consulting Bench Time",
  "difficulty": "Medium",
  "company": "Google",
  "premium": true,
  "question": "In consulting, being \u201con the bench\u201d means you have a gap between two client engagements.\n\nGoogle wants to know how many days of bench time each consultant had in 2021. Assume that each consultant is only staffed to one consulting engagement at a time.\n\nWrite a query to pull each employee ID and their total bench time in days during 2021.\n\nAssumptions:\n- All listed employees are current employees who were hired before 2021.\n- The engagements in the consulting_engagements table are complete for the year 2022.",
  "notes": [],
  "tables": [
    {
      "table_name": "staffing",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "is_consultant",
          "data_type": "BOOLEAN"
        },
        {
          "column_name": "job_id",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "consulting_engagements",
      "columns": [
        {
          "column_name": "job_id",
          "data_type": "INT"
        },
        {
          "column_name": "client_id",
          "data_type": "INT"
        },
        {
          "column_name": "start_date",
          "data_type": "DATE"
        },
        {
          "column_name": "end_date",
          "data_type": "DATE"
        },
        {
          "column_name": "contract_amount",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "staffing": [
      {
        "employee_id": 111,
        "is_consultant": "true",
        "job_id": 1
      },
