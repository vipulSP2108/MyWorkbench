      },
      {
        "employee_id": 156,
        "is_consultant": "true",
        "job_id": 4
      }
    ],
    "consulting_engagements": [
      {
        "job_id": 1,
        "client_id": 201,
        "start_date": "2021-01-01",
        "end_date": "2021-01-31",
        "contract_amount": 15000
      },
      {
        "job_id": 2,
        "client_id": 202,
        "start_date": "2021-04-01",
        "end_date": "2021-05-31",
        "contract_amount": 30000
      },
      {
        "job_id": 3,
        "client_id": 203,
        "start_date": "2021-09-01",
        "end_date": "2021-10-21",
        "contract_amount": 25000
      },
      {
        "job_id": 4,
        "client_id": 204,
        "start_date": "2021-06-01",
        "end_date": "2021-10-05",
        "contract_amount": 50000
      }
    ]
  },
  "sample_output": [
    {
      "employee_id": 111,
      "bench_days": 222
    },
    {
      "employee_id": 156,
      "bench_days": 238
    }
  ],
  "reference_sql": "SELECT \n  s.employee_id,\n  365 - SUM(DATEDIFF(e.end_date, e.start_date) + 1) AS bench_days\nFROM staffing s\nJOIN consulting_engagements e ON s.job_id = e.job_id\nWHERE s.is_consultant = 1 OR s.is_consultant = 'true'\nGROUP BY s.employee_id\nORDER BY s.employee_id;",
  "tags": [
    "aggregation",
    "date-manipulation",
