{
  "question_id": "q_067_consulting_bench_time",
  "slug": "consulting-bench-time",
  "title": "Consulting Bench Time",
  "difficulty": "Medium",
  "company": "Google",
  "premium": true,
  "question": "In consulting, 'bench time' refers to non-billable days between engagements. Calculate total bench time in days for each active consultant during 2021.\n\nAssume a full year is 365 days and consultants work on at most one engagement at a time. Order by bench days in descending order.",
  "notes": [],
  "tables": [
    {
      "table_name": "staffing",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "is_consultant",
          "data_type": "BOOLEAN"
        },
        {
          "column_name": "job_id",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "consulting_engagements",
      "columns": [
        {
          "column_name": "job_id",
          "data_type": "INT"
        },
        {
          "column_name": "start_date",
          "data_type": "DATE"
        },
        {
          "column_name": "end_date",
          "data_type": "DATE"
        }
      ]
    }
  ],
  "sample_data": {
    "staffing": [
      {
        "employee_id": 111,
        "is_consultant": "true",
        "job_id": 1
      },
      {
        "employee_id": 111,
        "is_consultant": "true",
        "job_id": 2
      },
      {
        "employee_id": 112,
        "is_consultant": "true",
        "job_id": 3
      }
    ],
    "consulting_engagements": [
      {
        "job_id": 1,
        "start_date": "01/25/2021",
        "end_date": "02/28/2021"
      },
      {
        "job_id": 2,
        "start_date": "05/01/2021",
        "end_date": "06/30/2021"
      },
      {
        "job_id": 3,
        "start_date": "01/01/2021",
        "end_date": "03/31/2021"
      }
    ]
  },
  "sample_output": [
    {
      "employee_id": 111,
      "bench_days": 269
    },
    {
      "employee_id": 112,
      "bench_days": 275
    }
  ],
  "reference_sql": "SELECT s.employee_id,\n       365 - SUM(DATEDIFF(e.end_date, e.start_date) + 1) AS bench_days\nFROM staffing s\nJOIN consulting_engagements e ON s.job_id = e.job_id\nWHERE s.is_consultant = 1\nGROUP BY s.employee_id\nORDER BY s.employee_id;",
