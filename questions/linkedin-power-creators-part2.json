{
  "question_id": "q_061_linkedin_power_creators_part2",
  "slug": "linkedin-power-creators-part2",
  "title": "LinkedIn Power Creators (Part 2)",
  "difficulty": "Medium",
  "company": "LinkedIn",
  "premium": true,
  "question": "The LinkedIn Creator team is analyzing user influence across organizations. An individual creator is considered a Power Creator if their personal follower count is strictly greater than the combined total follower count of all companies they work for.\n\nWrite a query to return the profile IDs of these power creators in ascending order.",
  "notes": [
    "A person can work at multiple companies.",
    "Compare personal followers against the sum of company followers for all companies they are associated with."
  ],
  "tables": [
    {
      "table_name": "personal_profiles",
      "columns": [
        {
          "column_name": "profile_id",
          "data_type": "INT"
        },
        {
          "column_name": "name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "followers",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "employee_company",
      "columns": [
        {
          "column_name": "personal_profile_id",
          "data_type": "INT"
        },
        {
          "column_name": "company_id",
          "data_type": "INT"
        }
      ]
    },
    {
      "table_name": "company_pages",
      "columns": [
        {
          "column_name": "company_id",
          "data_type": "INT"
        },
        {
          "column_name": "name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "followers",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "personal_profiles": [
      {
        "profile_id": 1,
        "name": "Nick Singh",
        "followers": 100000
      },
      {
        "profile_id": 2,
        "name": "Zach Wilson",
        "followers": 50000
      },
      {
        "profile_id": 3,
        "name": "Daliana Liu",
        "followers": 120000
      }
    ],
    "employee_company": [
      {
        "personal_profile_id": 1,
        "company_id": 10
      },
      {
        "personal_profile_id": 1,
        "company_id": 20
      },
      {
        "personal_profile_id": 2,
        "company_id": 30
      },
      {
        "personal_profile_id": 3,
        "company_id": 10
      },
      {
        "personal_profile_id": 3,
        "company_id": 40
      }
    ],
    "company_pages": [
      {
        "company_id": 10,
        "name": "DataLemur",
        "followers": 20000
      },
      {
        "company_id": 20,
        "name": "Ace The DS Interview",
        "followers": 30000
      },
      {
        "company_id": 30,
        "name": "Big Tech Corp",
        "followers": 100000
      },
      {
        "company_id": 40,
        "name": "Podcast Media",
        "followers": 40000
      }
    ]
  },
  "sample_output": [
    {
      "profile_id": 1
    },
    {
      "profile_id": 3
    }
  ],
  "expected_output": [
    {
      "profile_id": 1
    },
    {
      "profile_id": 3
    }
  ],
  "reference_sql": "SELECT \n  pp.profile_id\nFROM personal_profiles pp\nJOIN employee_company ec ON pp.profile_id = ec.personal_profile_id\nJOIN company_pages cp ON ec.company_id = cp.company_id\nGROUP BY pp.profile_id, pp.followers\nHAVING pp.followers > SUM(cp.followers)\nORDER BY pp.profile_id ASC;",
  "tags": [
    "aggregation",
    "linkedin",
    "join",
    "medium",
    "social-media"
  ],
  "order_sensitive": true,
