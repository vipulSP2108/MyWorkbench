{
  "question_id": "q_094_matching_rental_amenities",
  "slug": "matching-rental-amenities",
  "title": "Matching Rental Amenities",
  "difficulty": "Hard",
  "company": "Airbnb",
  "premium": true,
  "question": "The Airbnb Booking Recommendations team wants to know how substitutable two rentals are. Write a query that decides whether two rentals offer exactly the same set of amenities, and output the count of matching rentals.\n\nAssumptions given in the public write-up: rentals with the same amenities (e.g. kitchen + pool vs kitchen + pool) count as 1 match. A rental with an extra or missing amenity (e.g. kitchen + pool + fireplace vs pool + fireplace) is not a match.",
  "notes": [],
  "tables": [
    {
      "table_name": "rental_amenities",
      "columns": [
        {
          "column_name": "rental_id",
          "data_type": "INT"
        },
        {
          "column_name": "amenity",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "rental_amenities": [
      {
        "rental_id": 1,
        "amenity": "kitchen"
      },
      {
        "rental_id": 1,
        "amenity": "pool"
      },
      {
        "rental_id": 2,
        "amenity": "pool"
      },
      {
        "rental_id": 2,
        "amenity": "kitchen"
      },
      {
        "rental_id": 3,
        "amenity": "kitchen"
      },
      {
        "rental_id": 3,
        "amenity": "pool"
      },
      {
        "rental_id": 3,
        "amenity": "fireplace"
      },
      {
        "rental_id": 4,
        "amenity": "pool"
      },
      {
        "rental_id": 4,
        "amenity": "fireplace"
      }
    ]
  },
  "sample_output": [
    {
      "matching_airbnb": 1
    }
  ],
  "reference_sql": "SELECT a.rental_id AS rental_1, b.rental_id AS rental_2, COUNT(a.amenity) AS matching_amenities\nFROM rental_amenities a\nJOIN rental_amenities b ON a.amenity = b.amenity AND a.rental_id < b.rental_id\nGROUP BY a.rental_id, b.rental_id\nHAVING COUNT(a.amenity) >= 2\nORDER BY matching_amenities DESC, rental_1, rental_2;",
  "tags": [
    "aggregation",
    "airbnb",
    "cte",
    "hard",
    "join"
  ],
