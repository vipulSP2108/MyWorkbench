      "table_name": "webinar_attendance",
      "columns": [
        {
          "column_name": "event_id",
          "data_type": "INT"
        },
        {
          "column_name": "contact_id",
          "data_type": "INT"
        },
        {
          "column_name": "event_type",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "event_date",
          "data_type": "DATE"
        }
      ]
    }
  ],
  "sample_data": {
    "webinar_attendance": [
      {
        "event_id": 1,
