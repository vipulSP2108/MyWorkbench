        "event_type": "conference_registration",
        "event_date": "4/24/2022"
      },
      {
        "event_id": 7,
        "contact_id": 3,
        "event_type": "whitepaper_download",
        "event_date": "4/30/2022"
      },
      {
        "event_id": 8,
        "contact_id": 4,
        "event_type": "trial_request",
        "event_date": "4/30/2022"
      },
      {
        "event_id": 9,
        "contact_id": 4,
        "event_type": "webinar",
        "event_date": "5/14/2022"
      }
    ]
  },
  "sample_output": [
    {
      "webinar_pct": 13.0
    }
  ],
  "reference_sql": "SELECT \n  ROUND(100.0 * SUM(CASE WHEN event_type = 'webinar' THEN 1 ELSE 0 END) / COUNT(*), 0) AS webinar_pct\nFROM webinar_attendance\nWHERE event_date >= '2022-04-01' AND event_date <= '2022-04-30';",
