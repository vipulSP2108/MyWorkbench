{
  "question_id": "q_072_compensation_outliers",
  "slug": "compensation-outliers",
  "title": "Compensation Outliers",
  "difficulty": "Medium",
  "company": "Accenture",
  "premium": true,
  "question": "Accenture wants to flag compensation outliers. An employee is an outlier if their salary is either more than double (> 2x) or less than half (< 0.5x) of the average salary for their job title.\n\nWrite a query returning the employee ID, salary, and outlier status ('Overpaid' or 'Underpaid') for all outliers, ordered by employee ID.",
  "notes": [
    "Overpaid: salary > 2 * avg_salary for that job title",
    "Underpaid: salary < 0.5 * avg_salary for that job title"
  ],
  "tables": [
    {
      "table_name": "employee_pay",
      "columns": [
        {
          "column_name": "employee_id",
          "data_type": "INT"
        },
        {
          "column_name": "title",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "salary",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "department_id",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "employee_pay": [
      {
        "employee_id": 101,
        "title": "Data Analyst",
        "salary": 30000.0,
        "department_id": 1
      },
      {
        "employee_id": 102,
        "title": "Data Analyst",
        "salary": 35000.0,
        "department_id": 1
      },
      {
        "employee_id": 103,
        "title": "Data Analyst",
        "salary": 200000.0,
        "department_id": 1
      },
      {
        "employee_id": 201,
        "title": "Data Engineer",
        "salary": 100000.0,
        "department_id": 2
      },
      {
        "employee_id": 202,
        "title": "Data Engineer",
        "salary": 110000.0,
        "department_id": 2
      },
      {
        "employee_id": 203,
        "title": "Data Engineer",
        "salary": 40000.0,
        "department_id": 2
      }
    ]
  },
  "sample_output": [
    {
      "employee_id": 101,
      "salary": 30000.0,
      "status": "Underpaid"
    },
    {
      "employee_id": 102,
      "salary": 35000.0,
      "status": "Underpaid"
    },
    {
      "employee_id": 103,
      "salary": 200000.0,
      "status": "Overpaid"
    },
    {
      "employee_id": 203,
      "salary": 40000.0,
      "status": "Underpaid"
    }
  ],
  "expected_output": [
    {
      "employee_id": 101,
      "salary": 30000.0,
      "status": "Underpaid"
    },
    {
      "employee_id": 102,
      "salary": 35000.0,
      "status": "Underpaid"
    },
    {
      "employee_id": 103,
      "salary": 200000.0,
      "status": "Overpaid"
    },
    {
      "employee_id": 203,
      "salary": 40000.0,
      "status": "Underpaid"
    }
  ],
  "reference_sql": "WITH SalaryStats AS (\n  SELECT \n    employee_id, \n    salary, \n    title,\n    AVG(salary) OVER (PARTITION BY title) as avg_salary\n  FROM employee_pay\n),\nOutlierStatus AS (\n  SELECT \n    employee_id, \n    salary,\n    CASE \n      WHEN salary > (avg_salary * 2) THEN 'Overpaid'\n      WHEN salary < (avg_salary / 2) THEN 'Underpaid'\n      ELSE NULL \n    END as status\n  FROM SalaryStats\n)\nSELECT employee_id, salary, status\nFROM OutlierStatus\nWHERE status IS NOT NULL\nORDER BY employee_id;",
  "tags": [
    "aggregation",
    "accenture",
    "finance",
    "window-function",
    "case-statement"
  ],
  "order_sensitive": true,
