  "title": "Second Day Confirmation",
  "difficulty": "Easy",
  "company": "TikTok",
  "premium": false,
  "question": "Assume you're given tables with information about TikTok user sign-ups and confirmations through email and text. New users on TikTok sign up using their email addresses, and upon sign-up, each user receives a text message confirmation to activate their account.\n\nWrite a query to display the user IDs of those who did not confirm their sign-up on the first day, but confirmed on the second day.\n\nDefinition:",
  "notes": [
    "action_date refers to the date when users activated their accounts and confirmed their sign-up through text messages.",
    "Only User 1052 confirmed their sign-up on the second day.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "emails",
      "columns": [
        {
          "column_name": "email_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "signup_date",
          "data_type": "DATETIME"
        }
      ]
    },
    {
      "table_name": "texts",
      "columns": [
        {
          "column_name": "text_id",
          "data_type": "INT"
        },
        {
          "column_name": "email_id",
          "data_type": "INT"
        },
        {
          "column_name": "signup_action",
          "data_type": "VARCHAR(50)"
        },
        {
          "column_name": "action_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "emails": [
      {
        "email_id": "125",
        "user_id": "7771",
        "signup_date": "06/14/2022 00:00:00"
      },
      {
        "email_id": "433",
        "user_id": "1052",
        "signup_date": "07/09/2022 00:00:00"
      }
    ],
    "texts": [
      {
        "text_id": "6878",
        "email_id": "125",
        "signup_action": "Confirmed",
        "action_date": "06/14/2022 00:00:00"
      },
      {
        "text_id": "6997",
        "email_id": "433",
        "signup_action": "Not Confirmed",
        "action_date": "07/09/2022 00:00:00"
      },
      {
        "text_id": "7000",
        "email_id": "433",
        "signup_action": "Confirmed",
        "action_date": "07/10/2022 00:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "user_id": "1052"
    }
  ],
  "reference_sql": "SELECT DISTINCT e.user_id\nFROM emails e\nJOIN texts t ON e.email_id = t.email_id\nWHERE t.signup_action = 'Confirmed'\n  AND DATEDIFF(t.action_date, e.signup_date) = 1\nORDER BY e.user_id;",
