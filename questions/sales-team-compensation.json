        },
        {
          "column_name": "deal_size",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "employee_contract": [
      {
        "employee_id": 101,
        "base": 60000,
        "commission": 0.1,
        "quota": 500000,
        "accelerator": 1.5
      },
      {
        "employee_id": 102,
        "base": 50000,
        "commission": 0.1,
        "quota": 400000,
        "accelerator": 1.5
      }
    ],
    "deals": [
      {
        "employee_id": 101,
        "deal_size": 400000
      },
      {
        "employee_id": 101,
        "deal_size": 400000
      },
      {
        "employee_id": 102,
        "deal_size": 100000
      },
      {
        "employee_id": 102,
        "deal_size": 200000
      }
    ]
  },
  "sample_output": [
    {
      "employee_id": 101,
      "total_compensation": 155000
    },
    {
      "employee_id": 102,
      "total_compensation": 80000
    }
  ],
  "reference_sql": "WITH deal_totals AS (\n  SELECT employee_id, SUM(deal_size) AS total_deals\n  FROM deals\n  GROUP BY employee_id\n)\nSELECT \n  c.employee_id,\n  ROUND(c.base + \n    CASE \n      WHEN IFNULL(d.total_deals, 0) >= c.quota THEN (c.commission * c.quota) + (c.accelerator * (d.total_deals - c.quota))\n      ELSE c.commission * IFNULL(d.total_deals, 0)\n    END, 2) AS total_compensation\nFROM employee_contract c\nLEFT JOIN deal_totals d ON c.employee_id = d.employee_id\nORDER BY total_compensation DESC, c.employee_id;",
