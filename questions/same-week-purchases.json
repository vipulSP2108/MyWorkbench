        "purchase_amount": "45.00",
        "purchase_date": "06/22/2022 12:00:00"
      },
      {
        "user_id": 742,
        "product_id": 1241,
        "purchase_amount": "50.00",
        "purchase_date": "06/28/2022 12:00:00"
      },
      {
        "user_id": 648,
        "product_id": 3632,
        "purchase_amount": "55.50",
        "purchase_date": "06/25/2022 12:00:00"
      },
      {
        "user_id": 123,
        "product_id": 8475,
        "purchase_amount": "67.30",
        "purchase_date": "06/29/2022 12:00:00"
      },
      {
        "user_id": 244,
        "product_id": 2341,
        "purchase_amount": "74.10",
        "purchase_date": "06/30/2022 12:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "single_purchase_pct": "40.00"
    }
  ],
  "reference_sql": "SELECT \n  ROUND(100.0 * COUNT(DISTINCT p.user_id) / COUNT(DISTINCT s.user_id), 2) AS same_week_pct\nFROM signups s\nLEFT JOIN purchases p \n  ON s.user_id = p.user_id \n AND DATEDIFF(p.purchase_date, s.signup_date) BETWEEN 0 AND 7;",
  "tags": [
    "date-manipulation",
