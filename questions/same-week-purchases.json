          "column_name": "purchase_amount",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "purchase_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "signups": [
      {
        "user_id": 445,
        "signup_date": "06/21/2022 12:00:00"
      },
      {
