{
  "question_id": "q_099_same_week_purchases",
  "slug": "same-week-purchases",
  "title": "Same Week Purchases",
  "difficulty": "Hard",
  "company": "Etsy",
  "premium": true,
  "question": "You are given two tables with Etsy's user signups and purchases. Write a query to obtain the percentage of users who signed up and made a purchase within 7 days of signing up. Round the result to 2 decimal places.",
  "notes": [],
  "tables": [
    {
      "table_name": "signups",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
