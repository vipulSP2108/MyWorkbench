{
  "question_id": "q_044_mean_median_mode",
  "slug": "mean-median-mode",
  "title": "Mean, Median, Mode",
  "difficulty": "Medium",
  "company": "Microsoft",
  "premium": true,
  "question": "You're given a list of numbers representing the number of emails in the inbox of Microsoft Outlook users. Before the Product Management team can start developing features related to bulk-deleting email or achieving inbox zero, they want the mean, median, and mode of the email counts.\n\nDisplay mean, median and mode (in this order), with the mean rounded to the nearest integer. Assume there are no ties for the mode.",
  "notes": [],
  "tables": [
    {
      "table_name": "inbox_stats",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "email_count",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "inbox_stats": [
      {
        "user_id": 123,
        "email_count": 100
      },
      {
        "user_id": 234,
        "email_count": 200
      },
      {
        "user_id": 345,
        "email_count": 300
      },
      {
        "user_id": 456,
        "email_count": 200
      },
      {
        "user_id": 567,
        "email_count": 200
      }
    ]
  },
  "sample_output": [
    {
      "mean": 200,
      "median": 200,
      "mode": 200
    }
  ],
  "reference_sql": "SELECT \n  ROUND(AVG(email_count)) AS mean,\n  (SELECT email_count FROM inbox_stats ORDER BY email_count LIMIT 1 OFFSET (SELECT COUNT(*)/2 FROM inbox_stats)) AS median,\n  (SELECT email_count FROM inbox_stats GROUP BY email_count ORDER BY COUNT(*) DESC LIMIT 1) AS mode\nFROM inbox_stats;",
