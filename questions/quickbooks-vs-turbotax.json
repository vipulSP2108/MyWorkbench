  "difficulty": "Easy",
  "company": "Intuit",
  "premium": true,
  "question": "Intuit wants to compare adoption between QuickBooks and TurboTax. Write a query to calculate the total number of tax filings made using TurboTax versus QuickBooks.",
  "notes": [],
  "tables": [
    {
      "table_name": "filed_taxes",
      "columns": [
        {
          "column_name": "filing_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "product",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "tax_year",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "filed_taxes": [
      {
        "filing_id": 1,
        "user_id": 101,
        "product": "TurboTax Deluxe",
        "tax_year": 2021
      },
      {
        "filing_id": 2,
        "user_id": 102,
        "product": "QuickBooks Online",
        "tax_year": 2021
      },
      {
        "filing_id": 3,
        "user_id": 103,
        "product": "TurboTax Premier",
        "tax_year": 2021
      },
      {
        "filing_id": 4,
        "user_id": 104,
        "product": "QuickBooks Self-Employed",
        "tax_year": 2021
      }
    ]
  },
  "sample_output": [
    {
      "turbotax_total": 2,
      "quickbooks_total": 2
    }
  ],
  "reference_sql": "SELECT \n  SUM(CASE WHEN product LIKE '%QuickBooks%' THEN 1 ELSE 0 END) AS quickbooks_users,\n  SUM(CASE WHEN product LIKE '%TurboTax%' THEN 1 ELSE 0 END) AS turbotax_users\nFROM filed_taxes;",
