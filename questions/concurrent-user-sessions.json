{
  "question_id": "q_089_concurrent_user_sessions",
  "slug": "concurrent-user-sessions",
  "title": "User Concurrent Sessions",
  "difficulty": "Hard",
  "company": "Pinterest",
  "premium": true,
  "question": "Assume you are given a table of user sessions, each with a start time and an end time. A session is concurrent with another\nsession if their start and end times overlap.\nWrite a query to output the session that is concurrent with the largest number of other sessions.",
  "notes": [],
  "tables": [
    {
      "table_name": "user_sessions",
      "columns": [
        {
          "column_name": "session_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "start_time",
          "data_type": "DATETIME"
        },
        {
          "column_name": "end_time",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "user_sessions": [
      {
        "session_id": 1,
        "user_id": 101,
        "start_time": "2022-01-01 10:00:00",
        "end_time": "2022-01-01 12:00:00"
      },
      {
        "session_id": 2,
        "user_id": 102,
        "start_time": "2022-01-01 10:30:00",
        "end_time": "2022-01-01 14:00:00"
      },
      {
        "session_id": 3,
        "user_id": 103,
        "start_time": "2022-01-01 11:00:00",
        "end_time": "2022-01-01 13:00:00"
      },
      {
        "session_id": 4,
        "user_id": 104,
        "start_time": "2022-01-01 13:30:00",
        "end_time": "2022-01-01 15:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "session_id": 2,
      "concurrent_sessions": 3
    }
  ],
  "reference_sql": "SELECT \n  a.session_id,\n  COUNT(b.session_id) AS concurrent_sessions\nFROM user_sessions a\nJOIN user_sessions b \n  ON a.session_id != b.session_id \n AND a.start_time < b.end_time \n AND a.end_time > b.start_time\nGROUP BY a.session_id\nORDER BY concurrent_sessions DESC, a.session_id\nLIMIT 1;",
  "tags": [
    "aggregation",
    "hard",
    "join",
    "left-join",
    "pinterest"
  ],
