  "sample_output": [
    {
      "international_calls_pct": "50.0"
    }
  ],
  "reference_sql": "SELECT \n  ROUND(100.0 * SUM(CASE WHEN c.country_id != r.country_id THEN 1 ELSE 0 END) / COUNT(*), 1) AS international_calls_pct\nFROM phone_calls p\nJOIN phone_info c ON p.caller_id = c.caller_id\nJOIN phone_info r ON p.receiver_id = r.caller_id;",
