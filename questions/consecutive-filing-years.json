  "sample_output": [
    {
      "user_id": "1"
    }
  ],
  "reference_sql": "WITH yearly AS (\n  SELECT DISTINCT user_id, YEAR(filing_date) AS filing_year\n  FROM filed_taxes\n  WHERE LOWER(product) LIKE '%turbotax%'\n),\nranked AS (\n  SELECT user_id, filing_year,\n         filing_year - ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY filing_year) AS grp\n  FROM yearly\n)\nSELECT DISTINCT user_id\nFROM ranked\nGROUP BY user_id, grp\nHAVING COUNT(*) >= 3\nORDER BY user_id;",
