{
  "question_id": "q_079_consecutive_filing_years",
  "slug": "consecutive-filing-years",
  "title": "Consecutive Filing Years",
  "difficulty": "Hard",
  "company": "Intuit",
  "premium": false,
  "question": "Intuit, a company known for its tax filing products like TurboTax and QuickBooks, offers multiple versions of these products.\n\nWrite a query that identifies the user IDs of individuals who have filed their taxes using any version of TurboTax for three or more consecutive years. Each user is allowed to file taxes once a year using a specific product. Display the output in the ascending order of user IDs.",
  "notes": [
    "User 1 has consistently filed their taxes using TurboTax for 3 consecutive years. User 2 is excluded from the results because they missed filing in the third year and User 3 transitioned to using QuickBooks in their third year.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "filed_taxes",
      "columns": [
        {
          "column_name": "filing_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "filing_date",
          "data_type": "DATETIME"
        },
        {
          "column_name": "product",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "filed_taxes": [
      {
        "filing_id": "1",
        "user_id": "1",
        "filing_date": "4/14/2019",
        "product": "TurboTax Desktop 2019"
