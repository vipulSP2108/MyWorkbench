{
  "question_id": "q_087_total_utilization_time",
  "slug": "total-utilization-time",
  "title": "Server Utilization Time",
  "difficulty": "Hard",
  "company": "Amazon",
  "premium": false,
  "question": "AWS is powered by fleets of servers, and senior management wants data-driven ways to optimise server usage.\n\nWrite a query that calculates the total time the fleet of servers was running, in units of full days.\n\nAssumptions: each server may start and stop several times; total fleet time is the sum of each server's uptime.",
  "notes": [],
  "tables": [
    {
      "table_name": "server_utilization",
      "columns": [
        {
          "column_name": "server_id",
          "data_type": "INT"
        },
        {
          "column_name": "status_time",
          "data_type": "DATETIME"
        },
        {
          "column_name": "session_status",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "server_utilization": [
      {
        "server_id": 1,
        "status_time": "08/02/2022 10:00:00",
        "session_status": "start"
      },
      {
        "server_id": 1,
        "status_time": "08/04/2022 10:00:00",
        "session_status": "stop"
      },
      {
        "server_id": 2,
        "status_time": "08/17/2022 10:00:00",
        "session_status": "start"
      },
      {
        "server_id": 2,
        "status_time": "08/24/2022 10:00:00",
        "session_status": "stop"
      }
    ]
  },
  "sample_output": [
    {
      "total_uptime_days": 21
    }
  ],
  "reference_sql": "WITH session_pairs AS (\n  SELECT \n    server_id,\n    status_time AS start_time,\n    LEAD(status_time) OVER (PARTITION BY server_id ORDER BY status_time) AS stop_time,\n    session_status\n  FROM server_utilization\n)\nSELECT \n  FLOOR(SUM(TIMESTAMPDIFF(SECOND, start_time, stop_time)) / 86400) AS total_uptime_days\nFROM session_pairs\nWHERE session_status = 'start' AND stop_time IS NOT NULL;",
  "tags": [
    "aggregation",
    "amazon",
    "cte",
    "date-manipulation",
    "hard",
    "lead-lag",
    "window-function"
  ],
