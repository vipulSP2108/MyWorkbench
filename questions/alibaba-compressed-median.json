  "title": "Compressed Median",
  "difficulty": "Hard",
  "company": "Alibaba",
  "premium": true,
  "question": "Series context (from the free sibling questions): you're given a table with the item count for each Alibaba order, together with the frequency of orders that have the same item count. Example from the series: 800 orders with 3 items each is stored as item_count = 3, order_occurrences = 800.\n\nLikely ask (unverified): write a query to find the median number of items per order, treating the table as compressed data (each item_count repeated order_occurrences times).\n\nNot available: the exact wording, rounding rules, example rows and expected output for this problem.",
  "notes": [],
  "tables": [
    {
      "table_name": "items_per_order",
      "columns": [
        {
          "column_name": "item_count",
          "data_type": "INT"
        },
        {
          "column_name": "order_occurrences",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "items_per_order": [
      {
        "item_count": "1",
        "order_occurrences": "500"
      },
      {
        "item_count": "2",
        "order_occurrences": "1000"
      },
      {
        "item_count": "3",
        "order_occurrences": "800"
      },
      {
        "item_count": "4",
        "order_occurrences": "1000"
      }
    ]
  },
  "sample_output": [
    {
      "median": "3.00"
    }
  ],
  "reference_sql": "WITH running AS (\n  SELECT \n    item_count,\n    order_occurrences,\n    SUM(order_occurrences) OVER (ORDER BY item_count) AS cum_orders,\n    SUM(order_occurrences) OVER () AS total_orders\n  FROM items_per_order\n)\nSELECT ROUND(AVG(item_count), 1) AS median\nFROM running\nWHERE cum_orders >= total_orders / 2.0\nLIMIT 1;",
