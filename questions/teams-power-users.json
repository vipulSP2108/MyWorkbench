{
  "question_id": "q_007_teams_power_users",
  "slug": "teams-power-users",
  "title": "Teams Power Users",
  "difficulty": "Easy",
  "company": "Microsoft",
  "premium": false,
  "question": "Write a query to identify the top 2 Power Users who sent the highest number of messages on Microsoft Teams in August 2022. Display the IDs of these 2 users along with the total number of messages they sent. Output the results in descending order based on the count of the messages.\n\nAssumption:",
  "notes": [
    "No two users have sent the same number of messages in August 2022.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "messages",
      "columns": [
        {
          "column_name": "message_id",
          "data_type": "INT"
        },
        {
          "column_name": "sender_id",
          "data_type": "INT"
        },
        {
          "column_name": "receiver_id",
          "data_type": "INT"
        },
        {
          "column_name": "content",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "sent_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "messages": [
      {
        "message_id": "901",
        "sender_id": "3601",
        "receiver_id": "4500",
        "content": "You up?",
        "sent_date": "08/03/2022 00:00:00"
      },
      {
        "message_id": "902",
        "sender_id": "4500",
        "receiver_id": "3601",
        "content": "Only if you're buying",
        "sent_date": "08/03/2022 00:00:00"
      },
      {
        "message_id": "743",
        "sender_id": "3601",
        "receiver_id": "8752",
        "content": "Let's take this offline",
        "sent_date": "06/14/2022 00:00:00"
      },
      {
        "message_id": "922",
        "sender_id": "3601",
        "receiver_id": "4500",
        "content": "Get on the call",
        "sent_date": "08/10/2022 00:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "sender_id": "3601",
      "message_count": "2"
    },
    {
      "sender_id": "4500",
      "message_count": "1"
    }
  ],
  "reference_sql": "SELECT sender_id, COUNT(message_id) AS message_count\nFROM messages\nWHERE YEAR(sent_date) = 2022 AND MONTH(sent_date) = 8\nGROUP BY sender_id\nORDER BY message_count DESC, sender_id ASC\nLIMIT 2;",
