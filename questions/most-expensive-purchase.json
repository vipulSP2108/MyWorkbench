  "difficulty": "Easy",
  "company": "Amazon",
  "premium": true,
  "question": "Amazon wants to analyze high-value transactions. Write a query to find the most expensive single purchase amount made by each customer.\n\nOutput the customer ID and their maximum purchase amount, sorted by maximum purchase amount in descending order.",
  "notes": [],
  "tables": [
    {
      "table_name": "transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "customer_id",
          "data_type": "INT"
        },
        {
          "column_name": "purchase_amount",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "purchase_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "transactions": [
      {
        "transaction_id": 1,
        "customer_id": 101,
        "purchase_amount": "150.00",
        "purchase_date": "01/01/2023"
      },
      {
        "transaction_id": 2,
        "customer_id": 101,
        "purchase_amount": "450.50",
        "purchase_date": "01/05/2023"
      },
      {
        "transaction_id": 3,
        "customer_id": 102,
        "purchase_amount": "89.99",
        "purchase_date": "01/02/2023"
      }
    ]
  },
  "sample_output": [
    {
      "customer_id": 101,
      "max_purchase": "450.50"
    },
    {
      "customer_id": 102,
      "max_purchase": "89.99"
    }
  ],
  "reference_sql": "SELECT \n  customer_id,\n  ROUND(MAX(purchase_amount), 2) AS max_purchase\nFROM transactions\nGROUP BY customer_id\nORDER BY max_purchase DESC, customer_id ASC;",
