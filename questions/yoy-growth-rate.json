{
  "question_id": "q_075_yoy_growth_rate",
  "slug": "yoy-growth-rate",
  "title": "Y-on-Y Growth Rate",
  "difficulty": "Hard",
  "company": "Wayfair",
  "premium": false,
  "question": "Assume you're given a table containing information about Wayfair user transactions for different products. Write a query to calculate the year-on-year growth rate for the total spend of each product, grouping the results by product ID.\n\nThe output should include the year in ascending order, product ID, current year's spend, previous year's spend and year-on-year growth percentage, rounded to 2 decimal places.",
  "notes": [
    "Product ID 123424 is analyzed for multiple years: 2019, 2020, 2021, and 2022.",
    "In the year 2020, the current year's spend is 1000.20, and there is no previous year's spend recorded (indicated by an empty cell).",
    "In the year 2021, the current year's spend is 1246.44, and the previous year's spend is 1000.20.",
    "In the year 2022, the current year's spend is 2145.32, and the previous year's spend is 1246.44.",
    "To calculate the year-on-year growth rate, we compare the current year's spend with the previous year's spend.For instance, the spend grew by 24.62% from 2020 to 2021, indicating a positive growth rate.",
    "The dataset you are querying against may have different input & output - this is just an example!"
  ],
  "tables": [
    {
      "table_name": "user_transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "product_id",
          "data_type": "INT"
        },
        {
          "column_name": "spend",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "user_transactions": [
      {
        "transaction_id": "1341",
        "product_id": "123424",
        "spend": "1500.60",
        "transaction_date": "12/31/2019 12:00:00"
      },
      {
        "transaction_id": "1423",
        "product_id": "123424",
        "spend": "1000.20",
        "transaction_date": "12/31/2020 12:00:00"
      },
      {
        "transaction_id": "1623",
        "product_id": "123424",
        "spend": "1246.44",
        "transaction_date": "12/31/2021 12:00:00"
      },
      {
        "transaction_id": "1322",
        "product_id": "123424",
        "spend": "2145.32",
        "transaction_date": "12/31/2022 12:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "year": "2019",
      "product_id": "123424",
      "curr_year_spend": "1500.60",
      "prev_year_spend": "NULL",
      "yoy_rate": "NULL"
    },
    {
      "year": "2020",
      "product_id": "123424",
      "curr_year_spend": "1000.20",
      "prev_year_spend": "1500.60",
      "yoy_rate": "-33.35"
    },
    {
      "year": "2021",
      "product_id": "123424",
      "curr_year_spend": "1246.44",
      "prev_year_spend": "1000.20",
      "yoy_rate": "24.62"
    },
    {
      "year": "2022",
      "product_id": "123424",
      "curr_year_spend": "2145.32",
      "prev_year_spend": "1246.44",
      "yoy_rate": "72.12"
    }
  ],
  "reference_sql": "WITH cte AS (\n    SELECT\n        EXTRACT(YEAR FROM transaction_date) AS yr,\n        product_id,\n        spend\n    FROM user_transactions\n),\ncte2 AS (\n    SELECT\n        yr,\n        product_id,\n        SUM(spend) AS curr_year_spend,\n        LAG(SUM(spend)) OVER (\n            PARTITION BY product_id\n            ORDER BY yr\n        ) AS prev_year_spend,\n        LAG(yr) OVER (\n            PARTITION BY product_id\n            ORDER BY yr\n        ) AS prev_yr\n    FROM cte\n    GROUP BY product_id, yr\n)\nSELECT\n    yr,\n    product_id,\n    curr_year_spend,\n    CASE\n        WHEN prev_yr = yr - 1\n        THEN prev_year_spend\n    END AS prev_year_spend,\n    CASE\n        WHEN prev_yr = yr - 1\n        THEN ROUND(\n            ((curr_year_spend - prev_year_spend)\n             / prev_year_spend) * 100.0,\n            2\n        )\n    END AS yoy_rate\nFROM cte2\nORDER BY product_id, yr;",
  "tags": [
    "aggregation",
    "date-manipulation",
    "ecommerce",
    "finance",
    "hard",
    "lead-lag",
    "math",
    "wayfair",
    "window-function"
  ],
