{
  "question_id": "q_062_money_transfer_relationships",
  "slug": "money-transfer-relationships",
  "title": "Unique Money Transfer Relationships",
  "difficulty": "Medium",
  "company": "PayPal",
  "premium": true,
  "question": "You are given a table of PayPal payments showing the payer, the recipient, and the amount paid. A two-way unique relationship is established when two people send money back and forth.\n\nWrite a query to find the number of two-way unique relationships in this data.\n\nAssumption: a payer can send money to the same recipient multiple times.",
  "notes": [],
  "tables": [
    {
      "table_name": "payments",
      "columns": [
        {
          "column_name": "payer_id",
          "data_type": "INT"
        },
        {
          "column_name": "recipient_id",
          "data_type": "INT"
        },
        {
          "column_name": "amount",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "payments": [
      {
        "payer_id": 101,
        "recipient_id": 201,
        "amount": 30
      },
      {
        "payer_id": 201,
        "recipient_id": 101,
        "amount": 10
      },
      {
        "payer_id": 101,
        "recipient_id": 301,
        "amount": 20
      },
      {
        "payer_id": 301,
        "recipient_id": 101,
        "amount": 80
      },
      {
        "payer_id": 201,
        "recipient_id": 301,
        "amount": 70
      }
    ]
  },
  "sample_output": [
    {
      "unique_relationships": 2
    }
  ],
  "reference_sql": "WITH unique_pairs AS (\n  SELECT DISTINCT\n    LEAST(payer_id, recipient_id) AS p1,\n    GREATEST(payer_id, recipient_id) AS p2\n  FROM payments\n)\nSELECT COUNT(*) AS unique_relationships FROM unique_pairs;",
  "tags": [
    "finance",
    "medium",
    "paypal"
  ],
