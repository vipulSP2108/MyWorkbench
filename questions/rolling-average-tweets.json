      {
        "user_id": "111",
        "tweet_date": "06/05/2022 00:00:00",
        "tweet_count": "5"
      }
    ]
  },
  "sample_output": [
    {
      "user_id": "111",
      "tweet_date": "06/01/2022 00:00:00",
      "rolling_avg_3d": "2.00"
    },
    {
      "user_id": "111",
      "tweet_date": "06/02/2022 00:00:00",
      "rolling_avg_3d": "1.50"
    },
    {
      "user_id": "111",
      "tweet_date": "06/03/2022 00:00:00",
      "rolling_avg_3d": "2.00"
    },
    {
      "user_id": "111",
      "tweet_date": "06/04/2022 00:00:00",
      "rolling_avg_3d": "2.67"
    },
    {
      "user_id": "111",
      "tweet_date": "06/05/2022 00:00:00",
      "rolling_avg_3d": "4.00"
    }
  ],
  "reference_sql": "SELECT \n  user_id,\n  tweet_date,\n  ROUND(AVG(tweet_count) OVER (\n    PARTITION BY user_id \n    ORDER BY tweet_date \n    ROWS BETWEEN 2 PRECEDING AND CURRENT ROW\n  ), 2) AS rolling_avg_3d\nFROM tweets;",
